{
  "format_version": 1,
  "provider": {
    "assume_role": {
      "type": "TypeList",
      "optional": true,
      "max_items": 1,
      "element": {
        "kind": "resource",
        "resource": {
          "duration": {
            "type": "TypeString",
            "optional": true,
            "description": "The duration of the role session. Valid time units are ns, us (or µs), ms, s, h, or m.",
            "default": "\"900s\"",
            "validate": "validateAssumeRoleDuration"
          },
          "policy": {
            "type": "TypeString",
            "optional": true,
            "description": "IAM Policy JSON describing further restricting permissions for the IAM Role being assumed.",
            "validate": "ValidateJsonString"
          },
          "role_urn": {
            "type": "TypeString",
            "required": true,
            "description": "UCloud Resource Name (URN) of an IAM Role to assume prior to making API calls."
          },
          "session_name": {
            "type": "TypeString",
            "required": true,
            "description": "An identifier for the assumed role session."
          }
        }
      }
    },
    "base_url": {
      "type": "TypeString",
      "optional": true,
      "description": "...",
      "validate": "validateBaseUrl",
      "conflicts_with": [
        "insecure"
      ]
    },
    "insecure": {
      "type": "TypeBool",
      "optional": true,
      "description": "...",
      "conflicts_with": [
        "base_url"
      ]
    },
    "max_retries": {
      "type": "TypeInt",
      "optional": true,
      "description": "...",
      "default": "3"
    },
    "private_key": {
      "type": "TypeString",
      "optional": true,
      "description": "...",
      "default_func": "EnvDefaultFunc"
    },
    "profile": {
      "type": "TypeString",
      "optional": true,
      "description": "...",
      "default_func": "EnvDefaultFunc"
    },
    "project_id": {
      "type": "TypeString",
      "required": true,
      "description": "...",
      "default_func": "EnvDefaultFunc"
    },
    "public_key": {
      "type": "TypeString",
      "optional": true,
      "description": "...",
      "default_func": "EnvDefaultFunc"
    },
    "region": {
      "type": "TypeString",
      "required": true,
      "description": "...",
      "default_func": "EnvDefaultFunc"
    },
    "shared_credentials_file": {
      "type": "TypeString",
      "optional": true,
      "description": "...",
      "default_func": "EnvDefaultFunc"
    }
  },
  "configure": "providerConfigure"
}
