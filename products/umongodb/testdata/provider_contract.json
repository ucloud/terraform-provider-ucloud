        "node_count": {
          "type": "TypeInt",
          "required": true,
          "force_new": true,
          "validate": "IntInSlice"
        },
        "quantity": {
          "type": "TypeInt",
          "optional": true,
          "force_new": true,
          "default": "1",
          "diff_suppress": "suppressUnreadableDefault",
          "validate": "IntAtLeast"
