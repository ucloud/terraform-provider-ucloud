              },
              "is_disk_available": {
                "type": "TypeBool",
                "computed": true
              },
              "name": {
                "type": "TypeString",
                "computed": true
              },
              "size": {
                "type": "TypeInt",
                "computed": true
              },
              "source_disk_name": {
                "type": "TypeString",
                "computed": true
              },
              "status": {
                "type": "TypeString",
                "computed": true
