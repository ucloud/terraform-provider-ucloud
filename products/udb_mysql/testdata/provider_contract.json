{
  "format_version": 1,
  "resources": {
    "ucloud_udb_mysql_instance": {
      "schema": {
        "availability_zone": {
          "type": "TypeString",
          "required": true,
          "force_new": true
        },
        "charge_type": {
          "type": "TypeString",
          "optional": true,
          "force_new": true,
          "default": "\"Month\"",
          "validate": "StringInSlice"
        },
        "cpu": {
          "type": "TypeInt",
          "computed": true
        },
        "create_time": {
          "type": "TypeString",
          "computed": true
        },
        "db_version": {
          "type": "TypeString",
          "optional": true,
          "force_new": true,
          "default": "\"mysql-8.0\"",
          "validate": "StringInSlice"
        },
        "disk_space": {
          "type": "TypeInt",
          "required": true,
          "validate": "IntBetween"
        },
        "duration": {
          "type": "TypeInt",
          "optional": true,
          "force_new": true,
          "default": "1",
          "validate": "IntBetween"
        },
        "expire_time": {
          "type": "TypeString",
          "computed": true
        },
        "instance_mode": {
          "type": "TypeString",
          "optional": true,
          "force_new": true,
          "default": "\"HA\"",
          "validate": "StringInSlice"
        },
        "machine_type": {
          "type": "TypeString",
          "required": true,
          "validate": "StringInSlice"
        },
        "memory": {
          "type": "TypeInt",
          "computed": true
        },
        "modify_time": {
          "type": "TypeString",
          "computed": true
        },
        "name": {
          "type": "TypeString",
          "optional": true,
          "computed": true,
          "force_new": true,
          "validate": "StringLenBetween"
        },
        "param_group_id": {
          "type": "TypeString",
          "optional": true,
          "computed": true,
          "force_new": true
        },
        "password": {
          "type": "TypeString",
          "optional": true,
          "computed": true,
          "force_new": true,
          "sensitive": true,
          "validate": "StringLenBetween"
        },
        "port": {
          "type": "TypeInt",
          "optional": true,
          "force_new": true,
          "default": "3306",
          "validate": "IntBetween"
        },
        "private_ip": {
          "type": "TypeString",
          "computed": true
        },
        "status": {
          "type": "TypeString",
          "computed": true
        },
        "subnet_id": {
          "type": "TypeString",
          "optional": true,
          "computed": true,
          "force_new": true
        },
        "tag": {
          "type": "TypeString",
          "optional": true,
          "force_new": true
        },
        "vpc_id": {
          "type": "TypeString",
          "optional": true,
          "computed": true,
          "force_new": true
        }
      },
      "create": "resourceUCloudMySQLInstanceCreate",
      "read": "resourceUCloudMySQLInstanceRead",
      "update": "resourceUCloudMySQLInstanceUpdate",
      "delete": "resourceUCloudMySQLInstanceDelete",
      "importer": "ImportStatePassthrough",
      "timeouts": {
        "create": "30m0s",
        "delete": "10m0s",
        "update": "30m0s"
      }
    }
  },
  "data_sources": {
