{
  "format_version": 1,
  "resources": {
    "ucloud_vpn_connection": {
      "schema": {
        "create_time": {
          "type": "TypeString",
          "computed": true
        },
        "customer_gateway_id": {
          "type": "TypeString",
          "required": true,
          "force_new": true
        },
        "ike_config": {
          "type": "TypeList",
          "required": true,
          "max_items": 1,
          "element": {
            "kind": "resource",
            "resource": {
              "authentication_algorithm": {
                "type": "TypeString",
                "optional": true,
                "default": "\"sha1\"",
                "validate": "StringInSlice"
              },
              "dh_group": {
                "type": "TypeString",
                "optional": true,
                "default": "\"15\"",
                "validate": "StringInSlice"
              },
              "encryption_algorithm": {
                "type": "TypeString",
                "optional": true,
                "default": "\"aes128\"",
                "validate": "StringInSlice"
              },
              "exchange_mode": {
                "type": "TypeString",
                "optional": true,
                "default": "\"main\"",
                "validate": "StringInSlice"
              },
              "ike_version": {
                "type": "TypeString",
                "optional": true,
                "default": "\"ikev1\"",
                "validate": "StringInSlice"
              },
              "local_id": {
                "type": "TypeString",
                "optional": true,
                "computed": true,
                "validate": "validateVpnAuto"
              },
              "pre_shared_key": {
                "type": "TypeString",
                "required": true,
                "validate": "StringMatch"
              },
              "remote_id": {
                "type": "TypeString",
                "optional": true,
                "computed": true,
                "validate": "validateVpnAuto"
              },
              "sa_life_time": {
                "type": "TypeInt",
                "optional": true,
                "default": "86400",
                "validate": "IntBetween"
              }
            }
          }
        },
        "ipsec_config": {
          "type": "TypeList",
          "required": true,
          "max_items": 1,
          "element": {
            "kind": "resource",
            "resource": {
              "authentication_algorithm": {
                "type": "TypeString",
                "optional": true,
                "default": "\"sha1\"",
                "validate": "StringInSlice"
              },
              "encryption_algorithm": {
                "type": "TypeString",
                "optional": true,
                "default": "\"aes128\"",
                "validate": "StringInSlice"
              },
              "local_subnet_ids": {
                "type": "TypeSet",
                "required": true,
                "min_items": 1,
                "max_items": 10,
                "set": "HashString",
                "element": {
                  "kind": "schema",
                  "schema": {
                    "type": "TypeString"
                  }
                }
              },
              "pfs_dh_group": {
                "type": "TypeString",
                "optional": true,
                "default": "\"disable\"",
                "validate": "StringInSlice"
              },
              "protocol": {
                "type": "TypeString",
                "optional": true,
                "default": "\"esp\"",
                "validate": "StringInSlice"
              },
              "remote_subnets": {
                "type": "TypeSet",
                "required": true,
                "min_items": 1,
                "max_items": 20,
                "set": "HashString",
                "element": {
                  "kind": "schema",
                  "schema": {
                    "type": "TypeString",
                    "validate": "validateCIDRBlock"
                  }
                }
              },
              "sa_life_time": {
                "type": "TypeInt",
                "optional": true,
                "default": "3600",
                "validate": "IntBetween"
              },
              "sa_life_time_bytes": {
                "type": "TypeInt",
                "optional": true,
                "computed": true,
                "validate": "IntBetween"
              }
            }
          }
        },
        "name": {
          "type": "TypeString",
          "optional": true,
          "validate": "StringMatch"
        },
        "remark": {
          "type": "TypeString",
          "optional": true,
          "computed": true
        },
        "tag": {
          "type": "TypeString",
          "optional": true,
          "force_new": true,
          "default": "\"Default\"",
          "state_func": "stateFuncTag",
          "validate": "StringMatch"
        },
        "vpc_id": {
          "type": "TypeString",
          "required": true,
          "force_new": true
        },
        "vpn_gateway_id": {
          "type": "TypeString",
          "required": true,
          "force_new": true
        }
      },
      "create": "resourceUCloudVPNConnectionCreate",
      "read": "resourceUCloudVPNConnectionRead",
      "update": "resourceUCloudVPNConnectionUpdate",
      "delete": "resourceUCloudVPNConnectionDelete",
      "importer": "ImportStatePassthrough"
    },
    "ucloud_vpn_customer_gateway": {
